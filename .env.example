# ============================================================
# Study Abroad Automation Platform — Environment Variables
# ============================================================
# 1. Copy this file:  copy .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to git — it is in .gitignore
# ============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME="Study Abroad Automation Platform"
DEBUG=false

# ── Database (PostgreSQL) ─────────────────────────────────────
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=study_abroad_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ── LLM (Google Gemini - Free Tier) ──────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# ── Jina Reader ───────────────────────────────────────────────
# Free tier works without a key (limited rate)
# Get a free key at: https://jina.ai/
JINA_API_KEY=your_jina_api_key_here
JINA_TIMEOUT_SECONDS=30
JINA_MAX_CONTENT_CHARS=50000

# ── Security ──────────────────────────────────────────────────
# Change this to a long random string in production!
ADMIN_API_KEY=change-this-to-a-long-random-secret
BLOCK_PRIVATE_IPS=true

# ── Scheduler ─────────────────────────────────────────────────
MONITORING_START_MONTH=9
MONITORING_END_MONTH=7
RUN_DAYS=[1,15]
RUN_HOUR=2
RUN_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Karachi
SCHEDULER_ENABLED=true

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── Italy Module ───────────────────────────────────────────────
EXCEL_FILE_PATH=C:\path\to\your\excel\file.xlsx
# Secret for HMAC-SHA256 signed check links (change this!)
CHECK_LINK_SECRET=change-this-to-a-long-random-secret-32-chars
