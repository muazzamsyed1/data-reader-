# ============================================================
# PRIVATE / SENSITIVE FILES — never upload these
# ============================================================

# Environment variables (secrets, API keys, DB credentials)
.env
.env.*
*.env
.env.local
.env.production
.env.staging
.env.development

# Allow the example template (has NO real secrets)
!.env.example

# Countries Excel / data sheets
countriesEXCELsheetsData/*.xlsx
countriesEXCELsheetsData/*.xls
countriesEXCELsheetsData/*.csv
countriesEXCELsheetsData/.env

# Database files (SQLite)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# PostgreSQL dump / backup files
*.sql
*.dump
*.pgdump
*.backup
pg_dump/
db_backups/

# ============================================================
# PYTHON
# ============================================================

# Virtual environment
venv/
.venv/
env/
ENV/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json

# ============================================================
# ALEMBIC
# ============================================================

# Keep alembic migration scripts but ignore local db used for testing
alembic.ini.local

# ============================================================
# IDE / EDITOR
# ============================================================

.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# LOGS & TEMP FILES
# ============================================================

*.log
*.tmp
*.temp
logs/

# ============================================================
# NODE / FRONTEND (if applicable)
# ============================================================

frontend/node_modules/
frontend/.env
frontend/.env.*
frontend/dist/
frontend/build/
